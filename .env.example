# Copier ce fichier en .env puis remplir les valeurs.
# Identifiants de l'espace admin (http://localhost:8080/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Chaîne aléatoire d'au moins 16 caractères, par exemple : openssl rand -base64 32
SESSION_SECRET=
# Optionnel : PostgreSQL (obligatoire sur Vercel). Sans cette valeur, les devoirs vont dans data/db.json
DATABASE_URL=
